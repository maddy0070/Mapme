<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission MapMe asks for so far, and it is a normal one: the
      milestone haptic is a shaped waveform rather than a system click.

      Location permissions are deliberately absent. They arrive in the sprint
      that actually records a journey, together with the screen that explains
      why they are being asked for — never before.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      No Application subclass yet. One arrives when there is something real to
      start at process launch — the journey store, the recording service — and
      not a moment before.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MapMe.Starting"
        android:allowBackup="false">

        <!--
          allowBackup is off on purpose. Journey history is the most sensitive
          thing this app will ever hold, and shipping it to a cloud backup by
          default would contradict the one promise MapMe makes: your journey
          belongs to you. When there is history worth keeping, MapMe will offer
          an export the person chooses — not a copy they never agreed to.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MapMe.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
