<?xml version="1.0" encoding="utf-8"?>
<!-- Ink, with a single faint aurora field in the corner so the icon has depth
     on both light and dark launcher wallpapers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0 H108 V108 H0 Z"
        android:fillColor="@color/mapme_canvas" />

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30"
                android:centerY="26"
                android:gradientRadius="78"
                android:type="radial">
                <item android:offset="0" android:color="#332BF5C0" />
                <item android:offset="1" android:color="#0005080B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
