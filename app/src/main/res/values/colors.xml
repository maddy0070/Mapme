<?xml version="1.0" encoding="utf-8"?>
<!--
  Android needs a few MapMe colours before Compose is running: the cold-start
  window, the splash, the launcher icon. These are the only place a MapMe
  colour is duplicated outside MapMePalette.kt — keep them in step.

  mapme_window is overridden in values-night, so a cold start lands on the
  right ground in both modes instead of flashing the wrong one.
-->
<resources>
    <color name="mapme_window">#FFFDFAFB</color>
    <color name="mapme_night">#FF0E0B12</color>
    <color name="mapme_rose">#FFFF2D6F</color>
    <color name="mapme_rose_deep">#FFB10040</color>
</resources>
