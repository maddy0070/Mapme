<?xml version="1.0" encoding="utf-8"?>
<!--
  MapMe's voice lives here.

  Three modes, and everything MapMe says is one of them:

    FUNCTIONAL   "Here's your route for today."
    ENCOURAGING  "Nice. That's your longest journey yet."
    REASSURING   "Couldn't save that. Let's try again."

  Rules:
    - Short. If it needs a semicolon, it needs rewriting.
    - Never blame the person. It is never "you denied permission".
    - Never robotic. No "operation successful", no "error occurred".
    - Personality shows up; it does not perform. Not every line is a joke.
    - Say what happens next, not what went wrong.

  The typography is chosen to match this: Bricolage Grotesque has warmth and a
  little irregularity, which is what a short friendly sentence needs. Copy and
  type are one decision, not two.
-->
<resources>
    <string name="app_name">MapMe</string>

    <!-- Onboarding. Three beats, one drawing, told from three distances. -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Start my map</string>

    <string name="onboarding_1_headline">You\'re already drawing it.</string>
    <string name="onboarding_1_body">Every day you move through the world and leave a line behind you. Nobody has been keeping it.</string>

    <string name="onboarding_2_headline">MapMe keeps it.</string>
    <string name="onboarding_2_body">Quietly, in the background, on your phone. The walks, the wrong turns, the places you keep coming back to.</string>

    <string name="onboarding_3_headline">Give it a year.</string>
    <string name="onboarding_3_body">This is what a life looks like from above. Yours is about to start drawing.</string>

    <!--
      Home, in its real first state. It has nothing to report, so it looks
      forward instead of explaining itself. "Coming next / journey recording /
      until then this is how it will feel" was a changelog wearing a card.
    -->
    <string name="home_next_up">Recording arrives next</string>
    <string name="home_empty_headline">Your first line is coming.</string>
    <string name="home_empty_body">This is where your days will land — every walk, every wrong turn, drawn as you go.</string>
    <string name="home_replay_intro">Watch the intro again</string>
    <string name="home_appearance_action">Change appearance</string>

    <!--
      The map, and everything it can be waiting on.

      Tone note: friendly, never cute twice in a row. The offline line is
      allowed one turn of phrase because being offline is annoying and a
      little warmth helps; the style failure is our fault and says so plainly
      rather than making a joke at the person's expense.
    -->
    <string name="map_loading">Bringing your world in</string>
    <string name="map_recentre">Centre on my location</string>

    <string name="map_permission_eyebrow">Your location</string>
    <string name="map_permission_headline">Put yourself on the map.</string>
    <string name="map_permission_body">MapMe needs location to show where you are. It stays on your phone — nothing is recorded yet.</string>
    <string name="map_permission_action">Show me on the map</string>

    <string name="map_permission_blocked_headline">Location is switched off for MapMe.</string>
    <string name="map_permission_blocked_body">Android won\'t ask again from here, so it has to be Settings. The map works without it — you just won\'t see yourself on it.</string>
    <string name="map_permission_blocked_action">Open settings</string>

    <string name="map_no_provider_headline">Your phone isn\'t sharing a location.</string>
    <string name="map_no_provider_body">Location services are off. Turn them on and MapMe will find you.</string>
    <string name="map_no_provider_action">Location settings</string>

    <string name="map_offline_headline">Looks like the map took a wrong turn.</string>
    <string name="map_offline_body">No connection, so the map can\'t load. It\'ll be here when you\'re back.</string>
    <string name="map_tiles_headline">The map didn\'t quite arrive.</string>
    <string name="map_tiles_body">Some of it is missing. Worth another go.</string>
    <string name="map_style_headline">The map didn\'t load.</string>
    <string name="map_style_body">That one\'s on us, not on your connection. It needs a fix from our side.</string>
    <string name="map_retry">Try again</string>

    <!--
      The home state, now that the map is real. It says the true thing —
      nothing has been recorded — without inventing a statistic to fill the
      space, and looks forward rather than apologising.
    -->
    <string name="home_map_eyebrow">Nothing recorded yet</string>
    <string name="home_map_headline">This is your world.</string>
    <string name="home_map_body">Recording arrives next. When it does, your line starts here.</string>

    <!--
      Recording. The verbs are MapMe's: you start a journey and you finish it,
      you do not "start tracking" or "stop recording". The product is a record
      of a life, and the words on the buttons are the first place that is
      either true or not.
    -->
    <string name="journey_start">Start journey</string>
    <string name="journey_start_hint">Begin drawing your journey</string>
    <string name="journey_pause">Pause</string>
    <string name="journey_resume">Resume</string>
    <string name="journey_finish">Finish</string>
    <string name="journey_finish_confirm">Finish this journey?</string>
    <string name="journey_finish_yes">Yes, finish</string>
    <string name="journey_keep_walking">Keep walking</string>
    <string name="journey_recording">Recording</string>
    <string name="journey_paused">Paused</string>
    <string name="journey_paused_body">Nothing is being recorded. Your journey is safe.</string>
    <string name="journey_waiting">Finding you</string>
    <string name="journey_waiting_body">Waiting for a good enough fix to start drawing.</string>
    <string name="journey_saving">Saving your journey</string>

    <!-- The moment the sprint exists for. Said plainly, once. -->
    <string name="journey_done_eyebrow">Journey saved</string>
    <string name="journey_done_headline">You were here.</string>
    <string name="journey_done_action">Done</string>
    <string name="journey_discard">Delete</string>

    <string name="journey_error_permission">MapMe lost access to your location, so the journey stopped there. What you walked is saved.</string>
    <string name="journey_error_unavailable">Your phone stopped sharing a location, so the journey stopped there. What you walked is saved.</string>
    <string name="journey_error_storage">The journey could not be written to this phone. Nothing was lost that was already saved.</string>
</resources>
