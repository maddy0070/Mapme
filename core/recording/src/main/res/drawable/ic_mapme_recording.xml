        android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.2 C13.55,9.2 14.8,10.45 14.8,12 C14.8,13.55 13.55,14.8 12,14.8 C10.45,14.8 9.2,13.55 9.2,12 C9.2,10.45 10.45,9.2 12,9.2 Z" />
